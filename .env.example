# Copia este archivo a .env y ajusta los valores. Nunca commitear secretos reales.

# --- Postgres (infra/docker-compose.yml) ---
POSTGRES_USER=doctorado
POSTGRES_PASSWORD=doctorado_dev_only
POSTGRES_DB=doctorado
POSTGRES_PORT=5432
DATABASE_URL=postgresql://doctorado:doctorado_dev_only@localhost:5432/doctorado?schema=public

# --- API (apps/api) ---
API_PORT=4000
NODE_ENV=development
# Origen(es) permitidos para CORS, separados por coma — incluye apps/web (3000).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Secreto usado para firmar el token CSRF derivado de la sesión (ver CsrfService).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=changeme-generate-a-real-secret-min-48-bytes

# Duración de la sesión (access) y del refresh, en segundos
SESSION_TTL_SECONDS=900
REFRESH_TTL_SECONDS=1209600

# Argon2id — parámetros de costo (ajustar según hardware del servidor)
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Web (apps/web) ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
